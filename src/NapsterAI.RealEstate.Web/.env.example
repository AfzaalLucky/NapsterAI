# Copy to .env.local (or .env.production.local for a prod build) and adjust - see .gitignore,
# these *.local variants are never committed, unlike .env.development which is safe to commit
# because it only points at a local dev API with no secrets.
VITE_API_BASE_URL=http://localhost:5080/api

# See .env.development for how to obtain a companion id for the AI chat widget.
VITE_REAL_ESTATE_COMPANION_ID=
VITE_REAL_ESTATE_VOICE_ID=alloy
